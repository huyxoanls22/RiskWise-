# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-app-url.example.com"

# Supabase SaaS Configuration (anon key is public-by-design, but do NOT commit
# real project values — set these as deployment secrets instead).
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Twelve Data API Configuration (server-side key is secret; the VITE_ prefixed
# variant is exposed to the browser, prefer the server-only key).
TWELVE_DATA_API_KEY="your-twelve-data-api-key"

# Secret used to HMAC-sign license keys. MUST be a long random string and MUST
# only ever live on the server. Generate e.g. with: openssl rand -hex 32
LICENSE_SECRET_KEY="change-me-to-a-long-random-secret"

# Admin PIN protecting the license generator and feedback admin endpoints.
# Use a strong, unique value. There is no hardcoded fallback in code.
ADMIN_PIN="change-me-to-a-strong-pin"
